+  "headers": "POST /v1/messages HTTP/1.1\r\ncontent-length: 7591\r\nuser-agent: ureq/3.4.0\r\naccept: */*\r\nhost: 127.0.0.1:55069\r\ncontent-type: application/json\r\nx-idempotency-key: zenpi-7b1f8e655ec2df0fb5c60e75b46542b43da56969847cdca18395de1a985206b7\r\nanthropic-version: 2023-06-01\r\nauthorization: Bearer local-fixture-key\r\naccept-encoding: identity",
+  "body": {
+    "max_tokens": 8192,
+    "messages": [
+      {
+        "content": [
+          {
+            "text": "begin interrupted response",
+            "type": "text"
+          }
+        ],
+        "role": "user"
+      }
+    ],
+    "model": "claude-sonnet-4-6",
+    "output_config": {
+      "effort": "high"
+    },
+    "stream": true,
+    "system": [
+      {
+        "text": "\nCommunication preference: INTJ (Analysts). Treat this MBTI label only as a requested writing style, not a diagnosis or identity. Coding/work style: Architecture, systems thinking, and precise tradeoffs. Be reflective and concise. Explain patterns and possibilities. Make reasoning and tradeoffs explicit. Organize clear next steps. Never change permissions, factual accuracy, or task requirements for this style.\n\n",
+        "type": "text"
+      }
+    ],
+    "thinking": {
+      "display": "summarized",
+      "type": "adaptive"
+    },
+    "tools": [
+      {
+        "description": "Replace one exact UTF-8 text occurrence atomically and return a bounded unified diff.",
+        "input_schema": {
+          "additionalProperties": false,
+          "properties": {
+            "new": {
+              "maxLength": 524288,
+              "type": "string"
+            },
+            "old": {
+              "maxLength": 524288,
+              "type": "string"
+            },
+            "path": {
+              "type": "string"
+            }
+          },
+          "required": [
+            "path",
+            "old",
+            "new"
+          ],
+          "type": "object"
+        },
+        "name": "edit_file"
+      },
+      {
+        "description": "Find workspace files by glob using installed ripgrep, with explicit ignore/hidden options and bounded results.",
+        "input_schema": {
+          "additionalProperties": false,
+          "properties": {
+            "hidden": {
+              "default": false,
+              "type": "boolean"
+            },
+            "ignore": {
+              "default": true,
+              "type": "boolean"
+            },
+            "limit": {
+              "maximum": 256,
+              "minimum": 1,
+              "type": "integer"
+            },
+            "path": {
+              "default": ".",
+              "type": "string"
+            },
+            "pattern": {
+              "type": "string"
+            }
+          },
+          "required": [
+            "pattern"
+          ],
+          "type": "object"
+        },
+        "name": "find"
+      },
+      {
+        "description": "List one workspace directory without recursively following links.",
+        "input_schema": {
+          "additionalProperties": false,
+          "properties": {
+            "max_entries": {
+              "maximum": 128,
+              "minimum": 1,
+              "type": "integer"
+            },
+            "path": {
+              "default": ".",
+              "type": "string"
+            }
+          },
+          "type": "object"
+        },
+        "name": "list_directory"
+      },
+      {
+        "description": "Load the body of one available skill by exact name. Optional arguments are literal text. Disabled skills cannot be model-invoked. Load again in each new turn before using read_skill_resource.",
+        "input_schema": {
+          "additionalProperties": false,
+          "properties": {
+            "arguments": {
+              "type": "string"
+            },
+            "name": {
+              "type": "string"
+            }
+          },
+          "required": [
+            "name"
+          ],
+          "type": "object"
+        },
+        "name": "load_skill"
+      },
+      {
+        "description": "Read a UTF-8 text file inside the workspace with a byte limit.",
+        "input_schema": {
+          "additionalProperties": false,
+          "properties": {
+            "max_bytes": {
+              "maximum": 524288,
+              "minimum": 1,
+              "type": "integer"
+            },
+            "path": {
+              "type": "string"
+            }
+          },
+          "required": [
+            "path"
+          ],
+          "type": "object"
+        },
+        "name": "read_file"
+      },
+      {
+        "description": "Read a bounded UTF-8 resource relative to a skill loaded with load_skill in this turn. Paths stay inside that skill directory; SKILL.md must use load_skill.",
+        "input_schema": {
+          "additionalProperties": false,
+          "properties": {
+            "path": {
+              "type": "string"
+            },
+            "skill": {
+              "type": "string"
+            }
+          },
+          "required": [
+            "skill",
+            "path"
+          ],
