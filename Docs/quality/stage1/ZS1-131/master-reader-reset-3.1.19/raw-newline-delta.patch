 /// This needs to be static because there can be one event reader.
 static INTERNAL_EVENT_READER: Mutex<Option<InternalEventReader>> = parking_lot::const_mutex(None);
 
+/// Discard complete events and incomplete input bytes before handing the terminal
+/// to another process. This does not flush the operating system's input queue.
+///
+/// Call only while the application has stopped all event readers and no cursor
+/// position query is running. A concurrent reader returns `WouldBlock`; callers
+/// must keep terminal input suspended and handle that error. The next poll/read
+/// constructs a fresh input source. This API is unavailable with event-stream.
+#[cfg(all(unix, not(feature = "event-stream")))]
+pub fn reset_event_reader() -> std::io::Result<()> {
+    let mut reader = INTERNAL_EVENT_READER.try_lock().ok_or_else(|| {
+        std::io::Error::new(std::io::ErrorKind::WouldBlock, "event reader is in use")
+    })?;
+    drop(reader.take());
+    Ok(())
+}
