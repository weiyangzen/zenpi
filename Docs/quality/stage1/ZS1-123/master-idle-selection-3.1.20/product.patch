+            .and_then(|path| summaries.iter().position(|summary| summary.path == path))
+            .unwrap_or_else(|| {
+                self.session_browser_cursor
+                    .min(summaries.len().saturating_sub(1))
+            });
+        self.session_browser = summaries;
+        self.dirty = true;
