+/// Local interactive inspection: no Agent lock, a 30-second operation deadline,
+/// bounded stdout and cooperative cancellation between filesystem operations.
+/// On Unix every Git process has its own group, killed and reaped on all exits.
+/// Kernel filesystem calls themselves cannot be preempted; no detached reader
+/// thread is used to hide that boundary.
+pub fn diff_value_at_with_cancel(
+    workspace_root: impl AsRef<Path>,
+    path: Option<&str>,
+    cancelled: impl Fn() -> bool,
+) -> Result<Value, SlashActionError> {
+    let control = DiffControl {
+        cancelled: &cancelled,
+        deadline: std::time::Instant::now() + std::time::Duration::from_secs(30),
+    };
+    diff_value_at_inner(workspace_root.as_ref(), path, Some(&control))
+}
+
+struct DiffControl<'a> {
+    cancelled: &'a dyn Fn() -> bool,
+    deadline: std::time::Instant,
+}
+impl DiffControl<'_> {
+    fn check(&self) -> Result<(), SlashActionError> {
+        if (self.cancelled)() {
+            return Err(SlashActionError::Git("local diff cancelled".into()));
+        }
+        if std::time::Instant::now() >= self.deadline {
+            return Err(SlashActionError::Git(
+                "local diff exceeded 30-second deadline".into(),
+            ));
+        }
+        Ok(())
+    }
+}
