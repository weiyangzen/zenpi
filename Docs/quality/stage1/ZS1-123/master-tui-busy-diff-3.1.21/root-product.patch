+#[cfg(all(test, unix))]
+mod diff_cancel_tests {
+    use super::*;
+    use std::sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+    };
+    use std::time::{Duration, Instant};
+
+    #[test]
+    fn cancel_before_path_read_never_uses_the_filesystem() {
+        let result = diff_value_at_with_cancel("/does/not/exist", None, || true);
+        assert!(result.unwrap_err().to_string().contains("cancelled"));
+    }
+    #[test]
+    fn stalled_stdout_and_closed_stdout_child_are_cancelled_and_reaped() {
+        for close_stdout in [false, true] {
+            let dir = tempfile::tempdir().unwrap();
+            let pidfile = dir.path().join("pid");
+            let cancelled = Arc::new(AtomicBool::new(false));
+            let signal = Arc::clone(&cancelled);
+            let path = pidfile.clone();
+            let thread = std::thread::spawn(move || {
+                let mut command = Command::new("/bin/sh");
+                command
+                    .args([
+                        "-c",
+                        if close_stdout {
+                            "echo $$ > \"$1\"; exec 1>&-; exec sleep 30"
+                        } else {
+                            "echo $$ > \"$1\"; exec sleep 30"
+                        },
+                        "fixture",
+                    ])
+                    .arg(path)
+                    .stdout(Stdio::piped())
+                    .stderr(Stdio::null());
+                let check = || signal.load(Ordering::Acquire);
+                let control = DiffControl {
+                    cancelled: &check,
+                    deadline: Instant::now() + Duration::from_secs(5),
+                };
+                read_controlled_git(&mut command, 64, &control)
+            });
+            let deadline = Instant::now() + Duration::from_secs(2);
+            while !pidfile.exists() && Instant::now() < deadline {
+                std::thread::sleep(Duration::from_millis(2));
+            }
+            let pid: i32 = fs::read_to_string(pidfile).unwrap().trim().parse().unwrap();
+            let start = Instant::now();
+            cancelled.store(true, Ordering::Release);
+            let result = thread.join().unwrap();
+            assert!(result.unwrap_err().to_string().contains("cancelled"));
+            assert!(start.elapsed() < Duration::from_secs(1));
+            assert_eq!(unsafe { libc::kill(pid, 0) }, -1);
+            assert_eq!(unsafe { libc::kill(-pid, 0) }, -1);
+        }
+    }
+    #[test]
+    fn deadline_and_output_cap_reap_the_child() {
+        let not_cancelled = || false;
+        let control = DiffControl {
+            cancelled: &not_cancelled,
+            deadline: Instant::now() + Duration::from_millis(80),
+        };
+        let mut command = Command::new("/bin/sleep");
+        command.arg("30").stdout(Stdio::piped());
+        assert!(
+            read_controlled_git(&mut command, 64, &control)
+                .unwrap_err()
+                .to_string()
+                .contains("deadline")
+        );
+        let control = DiffControl {
+            cancelled: &not_cancelled,
+            deadline: Instant::now() + Duration::from_secs(2),
+        };
+        let mut command = Command::new("/usr/bin/yes");
+        command.stdout(Stdio::piped());
+        let (bytes, _, truncated) = read_controlled_git(&mut command, 64, &control).unwrap();
+        assert_eq!(bytes.len(), 64);
+        assert!(truncated);
+    }
+    #[test]
+    fn controlled_status_preserves_the_truncation_warning() {
+        let dir = tempfile::tempdir().unwrap();
+        assert!(
+            Command::new("git")
+                .args(["init", "-q"])
+                .arg(dir.path())
+                .status()
+                .unwrap()
+                .success()
+        );
+        for index in 0..500 {
+            fs::write(
+                dir.path()
+                    .join(format!("file-{index:04}-{}", "x".repeat(70))),
+                "sample\n",
+            )
+            .unwrap();
+        }
+        let original = diff_value_at(dir.path(), None).unwrap();
+        let controlled = diff_value_at_with_cancel(dir.path(), None, || false).unwrap();
+        let expected = original["status"].as_str().unwrap();
+        let actual = controlled["status"].as_str().unwrap();
+        assert!(expected.ends_with(DIFF_TRUNCATION_MARKER));
+        assert!(
+            actual.ends_with(DIFF_TRUNCATION_MARKER),
+            "controlled status silently omitted its truncation warning"
+        );
+        assert_eq!(actual, expected);
+        assert!(actual.len() <= MAX_STATUS_BYTES);
+    }
+
+    #[test]
+    fn controlled_and_original_diff_keep_the_same_path_and_output_contract() {
+        let dir = tempfile::tempdir().unwrap();
+        assert!(
+            Command::new("git")
+                .args(["init", "-q"])
+                .arg(dir.path())
+                .status()
+                .unwrap()
+                .success()
+        );
+        fs::create_dir(dir.path().join("dir")).unwrap();
+        fs::write(dir.path().join("dir/中文.txt"), "BOUND_TEXT\n").unwrap();
+        for path in [None, Some("."), Some("dir"), Some("dir/中文.txt")] {
+            assert_eq!(
+                diff_value_at(dir.path(), path).unwrap(),
+                diff_value_at_with_cancel(dir.path(), path, || false).unwrap()
+            );
+        }
+        for path in ["../outside", "dir/../dir/中文.txt"] {
+            assert!(matches!(
+                diff_value_at_with_cancel(dir.path(), Some(path), || false),
+                Err(SlashActionError::PathDenied(_))
+            ));
+        }
+    }
