+#[cfg(unix)]
+fn read_controlled_git(
+    command: &mut Command,
+    limit: usize,
+    control: &DiffControl<'_>,
+) -> Result<(Vec<u8>, i32, bool), SlashActionError> {
+    use std::os::{fd::AsRawFd, unix::process::CommandExt};
+    control.check()?;
+    command.process_group(0).stdin(Stdio::null());
+    struct OwnedGit(std::process::Child);
+    impl Drop for OwnedGit {
+        fn drop(&mut self) {
+            // A pipe holder may outlive the leader. Terminate the dedicated
+            // group even after EOF/leader exit, then reap the direct child.
+            unsafe {
+                libc::kill(-(self.0.id() as i32), libc::SIGKILL);
+            }
+            let _ = self.0.kill();
+            let _ = self.0.wait();
+        }
+    }
+    let mut child = OwnedGit(
+        command
+            .spawn()
+            .map_err(|e| SlashActionError::Git(e.to_string()))?,
+    );
+    let mut stdout = child
+        .0
+        .stdout
+        .take()
+        .ok_or_else(|| SlashActionError::Git("git stdout unavailable".into()))?;
+    let fd = stdout.as_raw_fd();
+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFL) };
+    if flags < 0 || unsafe { libc::fcntl(fd, libc::F_SETFL, flags | libc::O_NONBLOCK) } < 0 {
+        return Err(SlashActionError::Read(io::Error::last_os_error()));
+    }
+    let mut bytes = Vec::new();
+    let mut eof = false;
+    loop {
+        control.check()?;
+        let mut chunk = [0u8; 8192];
+        let capacity = chunk.len().min(limit + 1 - bytes.len());
+        if !eof {
+            match stdout.read(&mut chunk[..capacity]) {
+                Ok(0) => eof = true,
+                Ok(n) => {
+                    bytes.extend_from_slice(&chunk[..n]);
+                    if bytes.len() > limit {
+                        control.check()?;
+                        bytes.truncate(limit);
+                        return Ok((bytes, -1, true));
+                    }
+                    continue;
+                }
+                Err(e)
+                    if matches!(
+                        e.kind(),
+                        io::ErrorKind::WouldBlock | io::ErrorKind::Interrupted
+                    ) => {}
+                Err(e) => return Err(SlashActionError::Read(e)),
+            }
+        }
+        if eof && let Some(status) = child.0.try_wait().map_err(SlashActionError::Read)? {
+            control.check()?;
+            return Ok((bytes, status.code().unwrap_or(-1), false));
+        }
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+}
+
+#[cfg(not(unix))]
+fn read_controlled_git(
+    _command: &mut Command,
+    _limit: usize,
+    _control: &DiffControl<'_>,
+) -> Result<(Vec<u8>, i32, bool), SlashActionError> {
+    Err(SlashActionError::Git(
+        "cancellable local diff requires Unix process ownership on this host".into(),
+    ))
+}
