+impl Drop for LocalDiffHost {
+    fn drop(&mut self) {
+        if let Some(request) = &self.active {
+            request
+                .cancelled
+                .store(true, std::sync::atomic::Ordering::Release);
+        }
+        self.commands.take();
+        self.results.take();
+        if let Some(thread) = self.thread.take() {
+            let _ = thread.join();
+        }
+    }
