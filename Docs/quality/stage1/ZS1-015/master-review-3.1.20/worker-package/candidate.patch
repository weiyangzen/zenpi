+        tool: String,
+        output: Value,
+    },
+    Error {
+        call_id: String,
+        tool: String,
+        error: ToolFailure,
+    },
+}
+
+impl ToolResult {
+    pub fn is_success(&self) -> bool {
+        matches!(self, Self::Success { .. })
