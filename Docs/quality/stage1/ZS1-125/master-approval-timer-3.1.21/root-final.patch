+#[test]
+fn approval_terminal_clears_modal_and_stale_job_cannot_reopen_it() {
+    use zenpi::view_model::ViewEventKind as V;
+    let mut state = TuiState::default();
+    state.begin_stream_for_job(10);
+    state.set_busy(true);
+    state.present_approval(zenpi::approval::ApprovalRequest {
+        request_id: "visible-approval".into(),
+        turn_id: "turn-fixture".into(),
+        call_id: "call-visible".into(),
+        tool: "write_file".into(),
+        side_effect: zenpi::tools::ToolSideEffect::WorkspaceWrite,
+        arguments: serde_json::json!({"path":"unused.txt"}),
+        preview: None,
+        origin: zenpi::tools::ToolOrigin::AgentTool,
+        policy_digest: None,
+        lease_id: None,
+    });
+    assert!(render(&mut state, 180, 40).contains("visible-approval"));
+    let terminal = ViewEvent::with_context(
+        1,
+        None,
+        Some("turn-fixture".into()),
+        None,
+        V::TurnCancelled { reason: None },
+    )
+    .unwrap();
+    state.apply_view_event_for_job(10, &terminal);
+    assert_eq!(state.approval_count(), 0);
+    state.set_busy(false);
+    state.begin_stream_for_job(11);
+    state.set_busy(true);
+    let late = ViewEvent::with_context(
+        2,
+        None,
+        Some("turn-fixture".into()),
+        None,
+        V::ApprovalRequired {
+            approval_id: "STALE-TIMER-APPROVAL".into(),
+            tool: "write_file".into(),
+            arguments: "{}".into(),
+        },
+    )
+    .unwrap();
+    state.apply_view_event_for_job(10, &late);
+    state.apply_view_event_for_job(10, &terminal);
+    event(
+        &mut state,
+        11,
+        ProviderEvent::TextDelta {
+            delta: "REPLACEMENT-STREAM-LIVE".into(),
+        },
+    );
+    let screen = render(&mut state, 180, 40);
+    assert!(!screen.contains("STALE-TIMER-APPROVAL"));
+    assert!(screen.contains("REPLACEMENT-STREAM-LIVE"));
+    assert!(screen.contains("Ctrl-C"));
