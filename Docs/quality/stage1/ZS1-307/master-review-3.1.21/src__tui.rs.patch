+
+        query.path = "file-".into();
+        let ticks = Cell::new(0);
+        let timed = complete_file_query_with_clock(
+            &query,
+            || false,
+            |_| {
+                ticks.set(ticks.get() + 1);
+                Duration::from_millis(if ticks.get() == 1 { 150 } else { 151 })
+            },
+        )
+        .unwrap();
