+before=(p/'read-cancel-before-fix.log').read_text();after=(p/'read-cancel-after-fix.log').read_text();b=int(re.search(r'cancellation_to_return_ms=(\d+)',before)[1]);a=int(re.search(r'cancellation_to_return_ms=(\d+)',after)[1]);assert b>=1000 and a<1000
+case=p/'command-kill-production-config';result=read(case/'result.json');assert result['passed'] and result['binary_sha256']==binding['sha256'];assert sha(p/'command_kill_probe.py')==result['harness_sha256'];assert sha(p.parents[1]/'provider-kill319/kill_probe.py')==result['provider_fixture_sha256']
+for row in read(case/'artifact-index.json'): assert sha(case/row['path'])==row['sha256'],row['path']
+assert read(case/'owner-one.exit.json')['returncode']==-9
+assert all(read(case/f'owner-{n}.exit.json')['returncode']==0 for n in ['two','three'])
+assert len({read(case/f'owner-{n}.process.json')['pid'] for n in ['one','two','three']})==3
+assert (case/'effects.txt').read_text()=='START\n' and (case/'child-done').exists()
