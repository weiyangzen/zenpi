+fn read_all(store: &OutputArtifactStore, r: &ArtifactRef) -> Vec<u8> {
+    let mut out = Vec::new();
+    while out.len() < (r.bytes_stored as usize) {
+        let part = store
+            .read_range(r, out.len() as u64, 64 * 1024, 101)
+            .unwrap();
+        assert!(!part.is_empty());
+        out.extend(part);
+    }
