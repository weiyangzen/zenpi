+            max_concurrency: 2,
+            ..Default::default()
+        },
+        &|| false,
+        &mut |call| {
+            if call.name != "run_command" {
+                return ToolBatchDecision::Execute;
+            }
+            let capture = CommandOutputCapture::new(store.clone(), "s", &call.id, 100).unwrap();
+            captures.push(capture.clone());
