+    assert_eq!(
+        fs::metadata(&raw).unwrap().permissions().mode() & 0o777,
+        0o600
+    );
+    fs::remove_file(&raw).unwrap();
+    symlink(&outside, &raw).unwrap();
+    assert!(store.read_range(&r, 0, 7, 101).is_err());
+    fs::remove_file(&raw).unwrap();
+    fs::hard_link(&outside, &raw).unwrap();
