+        },
+    );
+    assert!(matches!(
+        result,
+        ToolResult::Error {
+            error: ToolFailure {
+                code: ToolErrorCode::Cancelled,
+                ..
+            },
+            ..
+        }
+    ));
+    let refs = capture.artifacts();
+    assert_eq!(refs.len(), 2);
+    assert!(refs.iter().all(|r| !r.complete && r.finalized));
