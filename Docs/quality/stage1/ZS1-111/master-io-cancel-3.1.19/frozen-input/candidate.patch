+                refs.iter()
+                    .find(|r| r.stream == OutputStream::Stdout)
+                    .unwrap()
+            ),
+            if index == 0 {
+                b"first".to_vec()
+            } else {
+                b"second".to_vec()
+            }
+        );
+    }
