+    let stdout = report
+        .artifacts
+        .iter()
+        .find(|r| r.stream == OutputStream::Stdout)
+        .unwrap();
+    assert!(stdout.bytes_stored > 65536);
+    let saved = agent
+        .history()
+        .iter()
+        .find(|t| t.role == zenpi::core::TurnRole::Tool)
+        .unwrap();
+    assert_eq!(
+        saved.metadata.as_ref().unwrap()["output_capture"]["artifacts"]
+            .as_array()
+            .unwrap()
+            .len(),
+        2
+    );
+}
