+        .iter()
+        .position(|e| e["type"] == "tool_execution_finished")
+        .unwrap();
+    assert!(started < capture && capture < finished);
+    drop(agent);
+    let reopened = zenpi::session::SessionStore::open_existing_writable(&path).unwrap();
+    assert_eq!(
