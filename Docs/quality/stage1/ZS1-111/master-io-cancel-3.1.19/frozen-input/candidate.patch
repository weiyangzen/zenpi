+        .run_user_shell_with_cancel("!printf after-unwind", || false)
+        .unwrap();
+    assert!(!fired.load(Ordering::SeqCst));
+    assert!(
+        agent
+            .take_events()
+            .iter()
+            .any(|e| matches!(e, zenpi::core::AgentEvent::ToolResult { .. }))
+    );
