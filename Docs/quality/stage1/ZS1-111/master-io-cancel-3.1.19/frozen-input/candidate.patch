+    let calls = [
+        ToolCall {
+            id: "a".into(),
+            name: "run_command".into(),
+            arguments: json!({"command":"printf first"}),
+        },
+        ToolCall {
+            id: "b".into(),
+            name: "run_command".into(),
+            arguments: json!({"command":"printf second"}),
+        },
