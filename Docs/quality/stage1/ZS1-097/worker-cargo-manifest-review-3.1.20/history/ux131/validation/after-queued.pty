READY
FIRST=Key(KeyEvent { code: Char('g'), modifiers: KeyModifiers(CONTROL), kind: Press, state: KeyEventState(0x0) })
DRAINED=[Key(KeyEvent { code: Enter, modifiers: KeyModifiers(0x0), kind: Press, state: KeyEventState(0x0) })]
FLUSHED
AFTER=Key(KeyEvent { code: Char('x'), modifiers: KeyModifiers(0x0), kind: Press, state: KeyEventState(0x0) })
