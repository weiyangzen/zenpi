--- baseline/Cargo.toml
+++ current/Cargo.toml
@@ -17,6 +17,7 @@
 base64 = "0.23"
 crossterm = { version = "0.29", features = ["bracketed-paste"] }
 httpdate = "1.0"
+ignore = "0.4"
 ratatui = { version = "0.30", default-features = false, features = ["crossterm"] }
 serde = { version = "1.0", features = ["derive"] }
 serde_json = "1.0"
@@ -24,7 +25,9 @@
 thiserror = "2.0"
 toml = "0.9"
 unicode-width = "0.2"
+unicode-segmentation = "=1.13.3"
 ureq = { version = "3.4", default-features = true, features = ["json"] }
+yaml_serde = "0.10"
 [target.'cfg(unix)'.dependencies]
 libc = "0.2"
 
@@ -38,5 +41,10 @@
 [profile.release]
 opt-level = "z"
 lto = "thin"
+strip = "symbols"
 codegen-units = 1
 panic = "abort"
+
+# ZS1-131: fixed terminal reader reset; upstream 0.29.0 and features preserved.
+[patch.crates-io]
+crossterm = { path = "vendor/crossterm" }
