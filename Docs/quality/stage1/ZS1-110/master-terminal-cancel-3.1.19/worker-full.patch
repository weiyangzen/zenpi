 }
+
+#[test]
+fn native_terminal_cancel_on_text_done_stops_ready_tools_and_completion() {
+    assert_native_terminal_cancel(true);
+}
+
+#[test]
+fn native_terminal_cancel_on_first_tool_stops_remaining_tools_and_completion() {
+    assert_native_terminal_cancel(false);
+}
+
+fn assert_native_terminal_cancel(on_text: bool) {
+    let parts = json!([
+        {"text":"native thought","thought":true,"thoughtSignature":"c2lnbmF0dXJl"},
+        {"text":"native 日本語","thoughtSignature":"dGV4dA=="},
+        {"functionCall":{"id":"native_first","name":"read_file","args":{"path":"first.txt"}},"thoughtSignature":"dG9vbA=="},
+        {"functionCall":{"id":"native_second","name":"read_file","args":{"path":"second.txt"}}}
+    ]);
+    let mut chunks = vec![];
+    for part in parts.as_array().unwrap() {
+        let mut chunk = answer(json!([part]), "STOP");
+        chunk["candidates"][0]
+            .as_object_mut()
+            .unwrap()
+            .remove("finishReason");
+        chunk.as_object_mut().unwrap().remove("usageMetadata");
+        chunks.push(chunk);
+    }
+    chunks.push(answer(json!([]), "STOP"));
+    let (url, requests, server) = serve(vec![("text/event-stream".into(), sse(&chunks))]);
+    let cancelled = AtomicBool::new(false);
+    let mut seen = vec![];
+    let mut late = vec![];
+    let result = backend(url).complete_with_control(
+        CompletionRequest::new("u", &user(), None, &[tool()]),
+        &|| cancelled.load(Ordering::SeqCst),
+        &mut |event| {
+            if cancelled.load(Ordering::SeqCst) {
+                late.push(format!("{event:?}"));
+            }
+            if (on_text && matches!(event, ProviderEvent::TextDone { .. }))
+                || (!on_text && matches!(event, ProviderEvent::ToolCallDone { .. }))
+            {
+                cancelled.store(true, Ordering::SeqCst);
+            }
+            seen.push(event);
+            // Exercise cancellation independently of sink error propagation.
+            Ok(())
+        },
+    );
+    server.join().unwrap();
+    let requests = requests.lock().unwrap();
+    assert_eq!(requests.len(), 1);
+    assert!(
+        requests[0]
+            .0
+            .starts_with("POST /v1beta/models/gemini-2.5-flash:streamGenerateContent?alt=sse ")
+    );
+    assert!(cancelled.load(Ordering::SeqCst), "boundary was not reached");
+    assert!(seen.iter().any(|event| matches!(event, ProviderEvent::ReasoningDelta { delta } if delta == "native thought")));
+    assert!(seen.iter().any(
+        |event| matches!(event, ProviderEvent::TextDelta { delta } if delta == "native 日本語")
+    ));
+    let ready: Vec<_> = seen
+        .iter()
+        .filter_map(|event| match event {
+            ProviderEvent::ToolCallDone { call } => Some(call),
+            _ => None,
+        })
+        .collect();
+    eprintln!(
+        "Gemini on_text={on_text}, cancelled_result={}, ready={}, late={late:?}",
+        matches!(result, Err(BackendError::Cancelled)),
+        ready.len()
+    );
+    assert!(
+        late.is_empty(),
+        "events published after cancellation: {late:?}"
+    );
+    assert!(matches!(result, Err(BackendError::Cancelled)));
+    assert_eq!(ready.len(), usize::from(!on_text));
+    if !on_text {
+        assert_eq!(ready[0].id, "native_first");
+        assert_eq!(ready[0].arguments, json!({"path":"first.txt"}));
+    }
+    assert!(
+        !seen
+            .iter()
+            .any(|event| matches!(event, ProviderEvent::Completed { .. }))
+    );
+}
