+    rx.recv_timeout(Duration::from_secs(2)).unwrap();
+    let start = Instant::now();
+    cancelled.store(true, Ordering::SeqCst);
+    assert!(matches!(
+        worker.join().unwrap(),
+        Err(BackendError::Cancelled)
+    ));
+    assert!(start.elapsed() < Duration::from_millis(700));
+    h.join().unwrap();
