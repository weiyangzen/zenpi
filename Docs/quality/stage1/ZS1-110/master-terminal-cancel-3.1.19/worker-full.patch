+            .set_read_timeout(Some(Duration::from_secs(2)))
+            .unwrap();
+        assert_eq!(stream.read(&mut b).unwrap(), 0);
+    });
+    let cancelled = Arc::new(AtomicBool::new(false));
+    let flag = cancelled.clone();
