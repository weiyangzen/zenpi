@@ -0,0 +1,77 @@
+name: zenpi CI
+
+on:
+  push:
+  pull_request:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: zenpi-${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  verify:
+    name: Format, lint, test, and contract checks
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - name: Check out source
+        uses: actions/checkout@v4
+
+      - name: Install stable Rust
+        uses: dtolnay/rust-toolchain@stable
+        with:
+          components: rustfmt, clippy
+
+      - name: Cache Cargo artifacts
+        uses: Swatinem/rust-cache@v2
+
+      - name: Check formatting
+        run: cargo fmt --all -- --check
+
+      - name: Run Clippy
+        run: cargo clippy --all-targets --all-features -- -D warnings
+
+      - name: Run tests
+        # Several integration fixtures bind short-lived loopback listeners;
+        # serial execution avoids OS-level port/resource contention while
+        # retaining the complete all-targets matrix.
+        run: cargo test --all-targets --all-features --locked -- --test-threads=1
+
+      - name: Validate execution blueprint and Gantt
+        run: python3 tools/validate_blueprint.py
+
+      - name: Validate v2 blueprint review draft
+        run: python3 tools/validate_blueprint_v2.py
+
+      - name: Report Rust source inventory
+        run: python3 tools/check_rust_loc.py
+
+      - name: Run runtime and size budget gate
+        run: python3 tools/bench_runtime.py --samples 3 --output /tmp/zenpi-runtime-budget.json
+
+      - name: Upload runtime budget receipt
+        uses: actions/upload-artifact@v4
+        with:
+          name: zenpi-runtime-budget-${{ github.run_id }}
+          path: /tmp/zenpi-runtime-budget.json
+
+      - name: Check two-mode boundary
+        run: python3 tools/check_modes.py
+
+      - name: Exercise headless JSONL protocol
+        run: cargo build --features dev-fixtures && ZENPI_BIN=target/debug/zenpi tools/headless_smoke.sh
+
+      - name: Exercise the installed release user paths
+        run: ZENPI_SMOKE_FEATURES=dev-fixtures python3 tools/user_smoke.py
+
+      - name: Exercise the release headless protocol
+        run: cargo build --release --features dev-fixtures && ZENPI_BIN=target/release/zenpi tools/headless_smoke.sh --release
+
+      - name: Package and verify the production artifact
+        run: |
+          tools/release.sh
+          (cd dist && shasum -a 256 -c *.sha256)
+          ! tar -tzf dist/*.tar.gz | grep -Eiq '(auth\.json|\.codex|\.zenpi|fixture|\.env)'
