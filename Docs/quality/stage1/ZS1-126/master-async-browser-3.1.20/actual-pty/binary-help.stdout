zenpi [--mode tui|headless] [--session PATH] [--backend openai|anthropic|google] [--profile NAME] [--model NAME]
zenpi config import-codex [--profile NAME]
zenpi config doctor [--profile NAME] [--json]
zenpi config list [--json] | config use NAME
zenpi pair import-codex|status|revoke --yes [--profile NAME]
zenpi session list [--json] | inspect PATH [--json]
zenpi session fork|export|import SOURCE DESTINATION
zenpi session gc --retain-newest N --older-than-seconds N --yes
zenpi extension list [--json] | install|upgrade PATH
zenpi extension disable|enable|remove NAME
default provider: ~/.zenpi (or read-only ~/.codex fallback); echo exists only in dev-fixtures builds
