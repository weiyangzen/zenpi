+            host.poll(&mut state);
+            release_tx.send(()).unwrap();
+            settle(&mut host, &mut state);
+            assert!(state.session_browser.is_empty(), "{change}");
+            assert!(
+                !state.messages().any(|m| m.text.contains("stale receipt")),
+                "{change}"
+            );
+        }
+    }
