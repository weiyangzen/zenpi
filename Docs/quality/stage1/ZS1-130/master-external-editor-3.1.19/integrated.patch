+
+    class Handler(BaseHTTPRequestHandler):
+        def log_message(self, *args):
+            pass
+        def do_POST(self):
+            calls.append(self.rfile.read(int(self.headers['Content-Length'])).decode())
+            self.send_response(503)
+            self.end_headers()
