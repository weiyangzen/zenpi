+#[test]
+fn configured_tool_deny_survives_jsonl_new_even_with_process_never() {
+    let root = tempdir().unwrap();
+    let mut agent = new_policy_agent(root.path());
+    agent.set_approval_policy(ApprovalPolicy {
+        mode: ApprovalMode::Never,
+        per_tool: [("write_file".into(), zenpi::approval::ApprovalDecision::Deny)].into(),
+        ..Default::default()
+    });
+    let mut wire = Wire::new(agent);
+    let old = wire.prompt("old-policy", "write in old session");
+    assert_eq!(old["success"], true, "{old}");
+    assert!(!root.path().join("note-0.txt").exists());
+    let prior = fs::read(root.path().join("initial.jsonl")).unwrap();
+    let new = wire.command("new-policy", "/new");
+    assert_eq!(new["success"], true, "{new}");
+    assert_ne!(new["project"]["session_id"], old["project"]["session_id"]);
+    let response = wire.prompt("next-policy", "write in new session");
+    assert_eq!(response["success"], true, "{response}");
+    assert!(!root.path().join("note-1.txt").exists());
+    let new_journal =
+        fs::read_to_string(new["data"]["new_session_path"].as_str().unwrap()).unwrap();
+    assert!(
+        new_journal.contains("tool approval denied"),
+        "{new_journal}"
+    );
+    assert!(!new_journal.contains("tool_execution_started"));
+    assert!(
+        fs::read(root.path().join("initial.jsonl"))
+            .unwrap()
+            .starts_with(&prior)
+    );
+    let rows = wire.finish();
+    assert!(
+        !rows
+            .iter()
+            .any(|row| row["event"]["type"] == "approval_request")
+    );
+}
