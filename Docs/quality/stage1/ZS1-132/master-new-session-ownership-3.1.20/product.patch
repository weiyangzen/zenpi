+
+struct NewSessionJob {
+    id: crate::runtime::JobId,
+    project: String,
+    owner: Arc<Mutex<crate::core::Agent>>,
+    submitted: SubmittedInput,
+    result: NewSessionResultCell,
+    detached: bool,
