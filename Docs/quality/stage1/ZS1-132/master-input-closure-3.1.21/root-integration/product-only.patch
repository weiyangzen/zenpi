+
+fn close_input_responses<W: Write>(
+    pending: &mut Vec<PendingInputResponse>,
+    output: &mut W,
+    replay: &mut ReplayState,
+) -> Result<(), HeadlessError> {
+    for item in pending.drain(..) {
+        // This cancels only tickets not yet serviced. A detached owner may
+        // already be applying one, so an unavailable receipt is not proof
+        // that its durable queue mutation was cancelled.
+        item.ticket.cancel();
+        let response = match item.ticket.try_recv() {
+            Ok(result) => input_response(item.id, result),
+            Err(_) => StdioResponse::error_with_code(
+                item.id,
+                "input_queue",
+                "input_queue_result_unknown",
+                "runtime closed before the input receipt; the input may have been applied; inspect the input queue before retrying",
+            ),
+        };
+        replay.emission_project = Some(item.project);
+        write_cached_versioned_response(output, response, item.version, replay)?;
     }
     Ok(())
 }
