+mod replay_session_tests {
+    use super::*;
+
+    #[test]
+    fn session_reset_preserves_pending_identity_and_durable_terminal_replay() {
+        let dir = tempfile::tempdir().unwrap();
+        let old =
+            SessionStore::open_in_workspace(dir.path().join("old.jsonl"), dir.path()).unwrap();
+        let new =
+            SessionStore::open_in_workspace(dir.path().join("new.jsonl"), dir.path()).unwrap();
+        let project = ProjectContext {
+            project_id: "project-a".into(),
+            cwd: dir.path().display().to_string(),
+            session_id: old.session_id().into(),
+        };
+        let mut replay = ReplayState::open(&old).unwrap();
+        replay.admit(Some("old-completed"), "old-payload").unwrap();
+        replay
+            .remember_terminal("old-completed".into(), "old terminal\n".into())
+            .unwrap();
+        replay.admit(Some("queued-a"), "original-payload").unwrap();
+        replay
+            .request_projects
+            .insert("queued-a".into(), project.clone());
+        replay.admit(Some("new-b"), "new-payload").unwrap();
+        replay.reset_for_session(&new, Some("new-b"), 42).unwrap();
+        assert_eq!(
+            replay.admit(Some("queued-a"), "changed-payload").unwrap(),
+            RequestIdAdmission::InFlightSame
+        );
+        let response = replay.project_response(
+            StdioResponse::success(Some("queued-a".into()), "prompt", None).for_version(2),
+        );
+        assert_eq!(response.project, Some(project));
+        let line = encode_line(&response).unwrap();
+        replay
+            .remember_terminal("queued-a".into(), line.clone())
+            .unwrap();
+        replay.close().unwrap();
+        let mut restored = ReplayState::open(&new).unwrap();
+        assert_eq!(
+            restored
+                .admit(Some("queued-a"), "original-payload")
+                .unwrap(),
+            RequestIdAdmission::Replay
+        );
+        assert_eq!(
+            restored.admit(Some("queued-a"), "changed-payload").unwrap(),
+            RequestIdAdmission::Conflict
+        );
+        assert_eq!(restored.cached_line("queued-a"), Some(line.as_str()));
+        assert_eq!(
+            restored.admit(Some("new-b"), "new-payload").unwrap(),
+            RequestIdAdmission::UnknownOutcome
+        );
+        // Completed IDs from the old session are not imported as pending work.
+        assert_eq!(
+            restored
+                .admit(Some("old-completed"), "fresh-payload")
+                .unwrap(),
+            RequestIdAdmission::New
+        );
+    }
+
+    #[test]
+    fn session_reset_keeps_unfinished_foreign_request_unknown_after_restart() {
+        let dir = tempfile::tempdir().unwrap();
+        let old = SessionStore::open(dir.path().join("old.jsonl")).unwrap();
+        let new = SessionStore::open(dir.path().join("new.jsonl")).unwrap();
+        let mut replay = ReplayState::open(&old).unwrap();
+        replay.admit(Some("unfinished-a"), "payload-a").unwrap();
+        replay.reset_for_session(&new, None, 0).unwrap();
+        replay.close().unwrap();
+        let mut restored = ReplayState::open(&new).unwrap();
+        assert_eq!(
+            restored.admit(Some("unfinished-a"), "payload-a").unwrap(),
+            RequestIdAdmission::UnknownOutcome
+        );
+        assert_eq!(
+            restored.admit(Some("unfinished-a"), "different").unwrap(),
+            RequestIdAdmission::Conflict
+        );
+    }
+
+    #[test]
+    fn conflicting_target_does_not_replace_the_live_source_reservation() {
+        let dir = tempfile::tempdir().unwrap();
+        let old = SessionStore::open(dir.path().join("old.jsonl")).unwrap();
+        let new = SessionStore::open(dir.path().join("new.jsonl")).unwrap();
+        let mut target = ReplayState::open(&new).unwrap();
+        target.admit(Some("queued-a"), "different").unwrap();
+        target.close().unwrap();
+        let mut replay = ReplayState::open(&old).unwrap();
+        replay.admit(Some("queued-a"), "original").unwrap();
+        assert!(replay.reset_for_session(&new, None, 0).is_err());
+        assert_eq!(
+            replay.in_flight.get("queued-a").map(String::as_str),
+            Some("original")
+        );
+        assert_eq!(
+            replay.journal.as_ref().unwrap().session_path,
+            fs::canonicalize(old.path()).unwrap()
+        );
+    }
+}
